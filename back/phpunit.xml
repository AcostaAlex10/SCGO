<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <php>
        <!-- El backend deja en el log lo que pasa con cada correo. En las pruebas
             ese log no va a la consola: las que lo miran lo mandan a un archivo. -->
        <ini name="error_log" value="/dev/null"/>
    </php>
    <testsuites>
        <testsuite name="unidad">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src/Reglas</directory>
            <directory suffix=".php">src/Ruteo</directory>
            <directory suffix=".php">src/Seguridad</directory>
            <directory suffix=".php">src/Http</directory>
            <directory suffix=".php">src/Monitoreo</directory>
            <directory suffix=".php">src/Migraciones</directory>
        </include>
    </source>
</phpunit>
