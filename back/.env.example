# Conexion a MariaDB / MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sgso
DB_USER=root
DB_PASSWORD=
# Poner true solo si la base esta en la nube y exige conexion cifrada (ej. Aiven)
DB_SSL=false

# Autenticacion (login)
# Obligatorio, de al menos 32 caracteres. Sin un valor válido la API no atiende
# pedidos. Generarlo con:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_SEGUNDOS=28800

# Origen permitido para CORS (el frontend). En desarrollo: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Mostrar los errores de PHP en la respuesta. Solo para desarrollo local:
# en producción queda en 0 y el detalle va al log.
APP_DEBUG=0

# Monitoreo de errores (B-04). Vacío = apagado, que es lo normal en local: el
# error igual queda en el log. El DSN real vive en Render, nunca acá.
SENTRY_DSN=
SENTRY_ENTORNO=produccion
